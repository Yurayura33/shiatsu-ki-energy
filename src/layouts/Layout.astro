---
// Fonts are self-hosted (bundled from @fontsource) so no visitor data goes to Google Fonts.
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/noto-serif-jp';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og-image.jpg`, Astro.site);

// Build the JSON-LD object, injecting context + canonical URL + image.
const jsonLd = schema
  ? { '@context': 'https://schema.org', ...schema, url: canonicalURL, image: ogImage }
  : null;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-RRDXJKRBTZ"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RRDXJKRBTZ');
    </script>
