---
// Fonts are self-hosted (bundled from @fontsource) so no visitor data goes to Google Fonts.
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/noto-serif-jp';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og-image.jpg`, Astro.site);

// Build the JSON-LD object, injecting context + canonical URL + image.
const jsonLd = schema
  ? { '@context': 'https://schema.org', ...schema, url: canonicalURL, image: ogImage }
  : null;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Google domains are for Google Analytics 4 + Google Ads, per
      https://developers.google.com/tag-platform/security/guides/csp
      (google.co.uk is listed separately because CSP can't wildcard the TLD), plus two Google Ads
      hosts the guide misses: googleads.g.doubleclick.net (script) and ad.doubleclick.net (img).
      Inline scripts stay blocked, so Google's code lives in public/consent.js.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.google.co.uk https://*.g.doubleclick.net https://ad.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.google.co.uk https://*.g.doubleclick.net https://ad.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com; frame-src https://www.googletagmanager.com; form-action 'none'; base-uri 'self';"
    />
    <script src={`${base}consent.js`} defer></script>
    <meta name="description" content={description} />
    <meta name="author" content="Joseph" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Japanese Wellness Therapy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Structured Data -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <CookieBanner />
    <slot />
    <script src={`${base}nav.js`} defer></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
