---
// Privacy notice (UK GDPR Art. 13/14). Drafted for the client — not legal advice.
// Company details are from Companies House (company 16157871). Section 1 also covers the
// Companies Act website disclosure (name, number, place of registration, registered office).
// Covers this website only; how the business handles emails/calls is outside its scope.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { therapy } from '../data/therapy';

// The nav anchors point at sections on the home page.
const navLinks = therapy.nav.map((link) => ({ ...link, href: `/${link.href}` }));
const { email, emailHref, phone, phoneHref } = therapy.contact;
---

<Layout
  title="Privacy Policy | Japanese Wellness Therapy"
  description="How the Japanese Wellness Therapy website handles personal data."
>
  <Header brand="Japanese Wellness Therapy" links={navLinks} />
  <main id="main" class="section legal">
    <div class="container legal__inner">
      <h1>Privacy Policy</h1>
      <p class="legal__updated">Last updated: 13 September 2026</p>

      <h2>1. Who we are</h2>
      <p>
        Japanese Wellness Therapy and this website are run by Iris One United Ltd (“we”, “us”), a
        private limited company registered in England and Wales (company number 16157871). Our
        registered office is 6 Sutton Plaza, Sutton, SM1 4FS. We are the controller of the personal data
        described in this policy. If you have any questions about it, email
        <a href={emailHref}>{email}</a> or call <a href={phoneHref}>{phone}</a>.
      </p>

      <h2>2. Visiting this website</h2>
      <p>
        This site has no user accounts, contact or booking forms, analytics or advertising, and it sets
        no cookies. Its fonts and images are served from this site, not from third parties.
      </p>
      <p>
        The site is hosted on GitHub Pages, a service of GitHub, Inc. Like any web host, GitHub records
        technical information about each visit, including your IP address, to deliver the site and keep
        it secure. See the
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub Privacy Statement</a>.
      </p>

      <h2>3. Contacting us</h2>
      <p>
        This website shows our email address and phone number, but it doesn’t collect or store anything
        you send us. This policy covers this website only. If you’d like to know how we handle
        information you give us by email or phone, or when you book a treatment, just ask using the
        details above.
      </p>

      <h2>4. Links to other websites</h2>
      <p>
        This site links to our YouTube, Instagram and Facebook pages. Once you follow a link, that
        service’s own privacy policy applies.
      </p>

      <h2>5. Where your data is processed</h2>
      <p>
        GitHub is based in the United States. Transfers of personal data to GitHub rely on the UK–US
        data bridge and the safeguards described in its privacy statement.
      </p>

      <h2>6. Your rights</h2>
      <p>Under UK data protection law you have the right to:</p>
      <ul>
        <li>ask for a copy of the personal data we hold about you;</li>
        <li>ask us to correct or delete it;</li>
        <li>ask us to restrict or stop using it, or object to how we use it;</li>
        <li>ask for it in a portable format.</li>
      </ul>
      <p>
        To use any of these rights, email <a href={emailHref}>{email}</a>. We will reply within one
        month. You can also complain to the Information Commissioner’s Office (ICO) at
        <a href="https://ico.org.uk/make-a-complaint/" target="_blank" rel="noopener noreferrer">ico.org.uk/make-a-complaint</a>
        or on 0303 123 1113, though we would appreciate the chance to put things right first.
      </p>

      <h2>7. Changes to this policy</h2>
      <p>If we change this policy, we will update this page and the date at the top.</p>
    </div>
  </main>
  <Footer backToTop={therapy.footer.backToTop} />
</Layout>
